# Supabase – copy to .env and fill in from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# App name shown on login page (default: "Agency Dashboard")
# VITE_APP_NAME=Agency Dashboard

# Set to "true" to skip login (public dashboard, no Supabase Auth required)
# VITE_AUTH_DISABLED=true

# Google Slides export (frontend OAuth — client ID is safe to expose in the browser)
# Use the same OAuth 2.0 Web client ID from Google Cloud Console as GA4/Settings Google connect.
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# Optional: Drive folder ID from the folder URL (everyone signs in with the same agency Google account)
# VITE_GOOGLE_DRIVE_REPORTS_FOLDER_ID=your-folder-id
# Enable "Google Sheets API" in the same Google Cloud project as the OAuth client above.
